# Адрес сайта (без слэша в конце) — используется в sitemap, canonical, OpenGraph
SITE_URL=https://gspinch.com
# Пароль для входа в админку /admin — придумайте длинный
ADMIN_PASSWORD=change-me-please
# Случайная строка для подписи cookie (сгенерировать: openssl rand -hex 32)
SESSION_SECRET=
NODE_ENV=production
PORT=3000
# Домен для Caddy (автоматический HTTPS)
DOMAIN=gspinch.com
