<!doctype html>
<html lang="ru">
<head>
<%- include('partials/head', { s }) %>
<title>Поступление в университеты Китая с персональным сопровождением — GSP·INCH</title>
<meta name="description" content="Помогаю выбрать программу, подготовить документы и поступить в китайский университет на грант или на платной основе. 9 лет в Китае, 100+ поступивших студентов.">
<link rel="canonical" href="<%= SITE_URL %>/">
<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:title" content="Поступление в Китай с персональным сопровождением">
<meta property="og:description" content="От выбора университета и подготовки документов до получения приглашения и зачисления.">
<meta property="og:url" content="<%= SITE_URL %>/">
<meta property="og:image" content="<%= SITE_URL %>/img/og.jpg">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfessionalService', name: 'GSP·INCH — поступление в Китай', url: SITE_URL + '/',
      image: SITE_URL + '/img/og.jpg', description: 'Консультации и сопровождение поступления в университеты Китая',
      areaServed: ['RU', 'KZ', 'UZ', 'KG', 'BY'],
      makesOffer: services.map(x => ({ '@type': 'Offer', name: x.title + (x.subtitle ? ' (' + x.subtitle + ')' : ''), description: x.description,
        price: (x.price.match(/[\d\s]+/) || [''])[0].replace(/\s/g, ''), priceCurrency: 'CNY' })) },
    { '@type': 'FAQPage', mainEntity: faq.map(q => ({ '@type': 'Question', name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.answer } })) }
  ]
}).replace(/</g, '\\u003c') %>
</script>
</head>
<body>
<%- include('partials/header') %>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text reveal">
        <p class="eyebrow">Обучение в Китае · 2027</p>
        <h1 class="hero__title">Поступление<br>в Китай</h1>
        <p class="hero__script">с персональным<br><span>сопровождением</span></p>
        <p class="hero__lead">От выбора университета и подготовки документов до получения приглашения и зачисления.</p>
        <div class="hero__actions">
          <a href="#contacts" class="btn btn--dark" data-goal="cta_hero">Записаться на консультацию <%- icon('arrow-up-right') %></a>
          <a href="#services" class="btn btn--ghost">Узнать об услугах</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="hero__img"><img src="/img/hero.jpg" alt="Беседка у озера и чайник с чаем — Китай" width="800" height="1314" fetchpriority="high"></div>
        <div class="hero__seal" aria-hidden="true"><span>留学中国</span><b>印</b></div>
      </div>
    </div>
    <div class="container">
      <ul class="stats reveal">
        <li><strong><%= s.stat1_value %></strong><span><%= s.stat1_label %></span></li>
        <li><strong><%= s.stat2_value %></strong><span><%= s.stat2_label %></span></li>
        <li><strong><%= s.stat3_value %></strong><span><%= s.stat3_label %></span></li>
      </ul>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about section" id="about">
    <div class="container about__inner">
      <div class="about__photo reveal">
        <img src="/img/kamila.jpg" alt="Камила — ментор по поступлению в Китай" width="690" height="1029" loading="lazy">
        <svg class="leaf leaf--about" viewBox="0 0 120 160" aria-hidden="true"><use href="#bamboo"/></svg>
      </div>
      <div class="about__text reveal">
        <p class="eyebrow">Обо мне</p>
        <h2 class="h2">Привет, я Камила!</h2>
        <p class="about__role">Ментор по поступлению в Китай</p>
        <p>С 2017 года живу и учусь в Китае. Прошла путь от языковых курсов до магистратуры на полном гранте. Помогаю поступать в университеты Китая честно, осознанно и без лишних затрат.</p>
        <ul class="facts">
          <li><%- icon('cap') %><span><b>HSK 5</b><br><b>HSKK 70</b></span></li>
          <li><%- icon('book') %><span><b>100+</b><br>поступивших студентов</span></li>
          <li><%- icon('leaf') %><span>Личный опыт / академический и практический</span></li>
        </ul>
        <a href="<%= s.telegram && s.telegram !== 'https://t.me/' ? s.telegram : '#contacts' %>" class="btn btn--olive" data-goal="about_more" <%- s.telegram && s.telegram !== 'https://t.me/' ? 'target="_blank" rel="noopener"' : '' %>>Узнать мой путь <%- icon('arrow') %></a>
      </div>
      <aside class="why reveal">
        <img src="/img/mist.jpg" alt="" class="why__bg" loading="lazy">
        <div class="why__card">
          <h3 class="why__title">Почему<br><span>со мной?</span></h3>
          <ul>
            <li><%- icon('tick') %>Честная и прозрачная работа</li>
            <li><%- icon('tick') %>Индивидуальная стратегия</li>
            <li><%- icon('tick') %>Опыт учёбы в Китае изнутри</li>
            <li><%- icon('tick') %>Поддержка на всех этапах</li>
            <li><%- icon('tick') %>Фокус на результат, а не на количество</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services section" id="services">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Услуги</h2>
        <p class="eyebrow">Подберём формат под вашу цель</p>
      </div>
      <div class="services__grid">
        <% services.forEach((x, i) => { %>
        <article class="service reveal" style="--d:<%= i * 80 %>ms">
          <div class="service__img"><% if (x.photo) { %><img src="<%= x.photo %>" alt="" loading="lazy"><% } %></div>
          <div class="service__body">
            <h3 class="service__title"><%= x.title %><% if (x.subtitle) { %> <span>(<%= x.subtitle %>)</span><% } %></h3>
            <p><%= x.description %></p>
            <div class="service__foot">
              <span class="service__price"><%= x.price %></span>
              <button class="round-btn" type="button" data-open-service="<%= i %>" aria-label="Подробнее: <%= x.title %>"><%- icon('arrow') %></button>
            </div>
          </div>
        </article>
        <% }) %>
        <article class="service service--cta reveal">
          <img src="/img/cta.jpg" alt="" loading="lazy">
          <div>
            <h3>Не знаете,<br>с чего начать?</h3>
            <p>Запишитесь на консультацию — разберём ваш кейс и составим пошаговый план.</p>
            <a href="#contacts" class="btn btn--light" data-goal="cta_services">Записаться <%- icon('arrow-up-right') %></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="steps section" id="steps">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="h2">Этапы работы</h2>
        <p class="eyebrow">От первого запроса до зачисления</p>
      </div>
      <ol class="steps__list reveal">
        <% [['search','Анализ кейса и целей',''],['layers','Подбор университетов','(стратегия 2+3)'],['doc','Подготовка документов','ML, CV, рекомендации'],['send','Подача заявок и сопровождение',''],['check','Зачисление и дальнейшая поддержка','']].forEach(([ic, t, sub], i) => { %>
          <li>
            <span class="steps__icon"><%- icon(ic) %></span>
            <span class="steps__num">0<%= i + 1 %></span>
            <span class="steps__title"><%= t %></span>
            <% if (sub) { %><small><%= sub %></small><% } %>
          </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="results section" id="results">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <h2 class="h2">Результаты студентов</h2>
      </div>
      <div class="results__inner">
        <div class="carousel reveal" data-carousel>
          <div class="carousel__track">
            <% results.forEach((r) => { %>
            <article class="result">
              <div class="result__img">
                <% if (r.photo) { %><img src="<%= r.photo %>" alt="<%= r.name %>" loading="lazy"><% } %>
                <% if (r.badge) { %><span class="badge"><%= r.badge %></span><% } %>
              </div>
              <div class="result__body">
                <h3><%= r.name %></h3>
                <p class="result__program"><%= r.program %><% if (r.university) { %><br><%= r.university %><% } %></p>
                <p><%= r.text %></p>
              </div>
            </article>
            <% }) %>
          </div>
          <div class="carousel__nav"><div class="dots"></div></div>
        </div>
        <ul class="results__stats reveal">
          <li><strong><%= s.res1_value %></strong><span><%= s.res1_label %></span></li>
          <li><strong><%= s.res2_value %></strong><span><%= s.res2_label %></span></li>
          <li><strong><%= s.res3_value %></strong><span><%= s.res3_label %></span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews section" id="reviews">
    <div class="container">
      <div class="section-head reveal"><h2 class="h2">Отзывы</h2></div>
      <div class="carousel carousel--reviews reveal" data-carousel>
        <button class="carousel__arrow carousel__arrow--prev" type="button" aria-label="Назад"><%- icon('arrow-left') %></button>
        <div class="carousel__track">
          <% reviews.forEach((r) => { %>
          <article class="review">
            <header>
              <% if (r.photo) { %><img src="<%= r.photo %>" alt="" class="avatar" loading="lazy"><% } else { %><span class="avatar avatar--letter"><%= r.name.charAt(0) %></span><% } %>
              <div><b><%= r.name %><% if (r.location) { %>, <%= r.location %><% } %></b><% if (r.program) { %><small><%= r.program %></small><% } %></div>
              <span class="quote" aria-hidden="true">“</span>
            </header>
            <p><%= r.text %></p>
          </article>
          <% }) %>
        </div>
        <button class="carousel__arrow carousel__arrow--next" type="button" aria-label="Вперёд"><%- icon('arrow') %></button>
        <div class="carousel__nav"><div class="dots"></div></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq section" id="faq">
    <div class="container faq__inner">
      <div class="reveal">
        <h2 class="h2">Частые вопросы</h2>
        <div class="faq__list">
          <% faq.forEach((q) => { %>
          <details class="faq__item">
            <summary><%= q.question %><%- icon('plus') %></summary>
            <p><%= q.answer %></p>
          </details>
          <% }) %>
        </div>
      </div>
      <div class="faq__img reveal"><img src="/img/panda.jpg" alt="Панда отдыхает на камне среди бамбука" loading="lazy"></div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact section" id="contacts">
    <div class="container">
      <div class="contact__card reveal">
        <img src="/img/cta.jpg" alt="" class="contact__bg" loading="lazy">
        <div class="contact__text">
          <p class="eyebrow eyebrow--light">Готовы начать?</p>
          <h2 class="h2">Запишитесь на консультацию</h2>
          <p>Разберём ваш кейс, оценим шансы и составим пошаговый план поступления в Китай.</p>
          <% if (s.telegram && s.telegram !== 'https://t.me/') { %>
            <a href="<%= s.telegram %>" class="contact__tg" target="_blank" rel="noopener" data-goal="telegram_click"><%- icon('telegram') %> Или напишите в Telegram</a>
          <% } %>
        </div>
        <form class="form" id="lead-form" action="/api/lead" method="post" novalidate>
          <% if (sent) { %><p class="form__ok" role="status">Спасибо! Заявка отправлена — я свяжусь с вами в ближайшее время.</p><% } %>
          <label>Ваше имя<input name="name" required maxlength="100" autocomplete="name"></label>
          <label>Telegram / WhatsApp / телефон<input name="contact" required maxlength="150" placeholder="@username или +7…"></label>
          <label>Формат
            <select name="package">
              <option value="">Пока не знаю — нужна консультация</option>
              <% services.forEach((x) => { %><option><%= x.title %><%= x.subtitle ? ' (' + x.subtitle + ')' : '' %></option><% }) %>
            </select>
          </label>
          <label><span>Комментарий <span class="muted">(необязательно)</span></span><textarea name="message" rows="2" maxlength="2000" placeholder="Уровень образования, желаемая программа…"></textarea></label>
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="utm">
          <label class="check"><input type="checkbox" required checked> <span>Согласна(ен) на обработку персональных данных согласно <a href="/privacy" target="_blank">политике</a></span></label>
          <button class="btn btn--light" type="submit">Записаться <%- icon('arrow') %></button>
          <p class="form__msg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<!-- Модалка с деталями услуги -->
<dialog class="modal" id="service-modal">
  <form method="dialog"><button class="modal__close" aria-label="Закрыть"><%- icon('close') %></button></form>
  <div class="modal__body"></div>
</dialog>
<script type="application/json" id="services-data"><%- JSON.stringify(services.map(x => ({ title: x.title, subtitle: x.subtitle, description: x.description, price: x.price, features: x.features.split('\n').map(f => f.trim()).filter(Boolean) }))).replace(/</g, '\\u003c') %></script>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="bamboo" viewBox="0 0 120 160">
    <g fill="currentColor"><path d="M60 0c-1 40-4 90-10 160h3C58 90 61 40 62 0z" opacity=".5"/>
    <path d="M58 30C40 25 20 30 5 45c20-5 38-6 53-10z"/><path d="M60 50c18-8 38-8 58 2-20 0-40 2-58 2z"/>
    <path d="M57 80C40 78 22 88 10 104c16-8 32-14 47-20z"/><path d="M58 100c16-4 34 2 48 16-16-6-32-10-48-12z"/>
    <path d="M60 15c10-10 25-14 40-12-15 4-28 9-40 15z"/></g>
  </symbol>
</svg>
<script src="/js/main.js?v=1" defer></script>
</body>
</html>
