<!doctype html>
<html lang="ru">
<head>
<%- include('partials/head', { s }) %>
<title>Поступление в университеты Китая с персональным сопровождением — GSP·INCH</title>
<meta name="description" content="Помогаю выбрать программу, подготовить документы и поступить в китайский университет на грант или на платной основе. 9 лет в Китае, 100+ поступивших студентов.">
<link rel="canonical" href="<%= SITE_URL %>/">
<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:title" content="Поступление в Китай с персональным сопровождением">
<meta property="og:description" content="От выбора университета и подготовки документов до получения приглашения и зачисления.">
<meta property="og:url" content="<%= SITE_URL %>/">
<meta property="og:image" content="<%= SITE_URL %>/img/og.jpg">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfessionalService', name: 'GSP·INCH — поступление в Китай', url: SITE_URL + '/',
      image: SITE_URL + '/img/og.jpg', description: 'Консультации и сопровождение поступления в университеты Китая',
      areaServed: ['RU', 'KZ', 'UZ', 'KG', 'BY'],
      makesOffer: services.map(x => ({ '@type': 'Offer', name: x.title + (x.subtitle ? ' (' + x.subtitle + ')' : ''), description: x.description,
        price: (x.price.match(/[\d\s]+/) || [''])[0].replace(/\s/g, ''), priceCurrency: 'CNY' })) },
    { '@type': 'FAQPage', mainEntity: faq.map(q => ({ '@type': 'Question', name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.answer } })) }
  ]
}).replace(/</g, '\\u003c') %>
</script>
</head>
<body>
<%- include('partials/stickers') %>
<%- include('partials/header') %>
<% const tones = ['blue', 'lime', 'paper']; const tg = s.telegram && s.telegram !== 'https://t.me/' ? s.telegram : ''; %>

<main>
  <!-- ═══ HERO: первая страница дневника ═══ -->
  <section class="hero" id="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="mono eyebrow" data-typed>Дневник поступления · запись №2027</p>
        <h1 class="hero__title"><span class="rise" style="--d:.1s">Поступление</span> <span class="rise" style="--d:.2s">в&nbsp;Китай</span></h1>
        <p class="hero__hand hand"><mark class="marker">с личным ментором,</mark> который сам прошёл этот путь</p>
        <p class="hero__lead">От выбора университета и подготовки документов до получения приглашения и зачисления — на грант или на платной основе.</p>
        <div class="hero__actions">
          <a href="#contacts" class="btn btn--lime" data-goal="cta_hero">Записаться на консультацию <%- icon('arrow-up-right') %></a>
          <a href="#about" class="btn btn--ghost">Листать дневник ↓</a>
        </div>
      </div>

      <div class="collage" aria-label="Коллаж: Китай, фото Камилы, посадочный талон">
        <span class="cn collage__cn" aria-hidden="true">留学</span>
        <figure class="stamp drop" style="--r:-7deg;--d:.15s">
          <img src="/img/hero.jpg" alt="Беседка у озера и чайник — Китай" width="800" height="1314" fetchpriority="high">
          <figcaption class="mono">中国 CHINA <b>¥2027</b></figcaption>
        </figure>
        <figure class="polaroid collage__me drop" style="--r:6deg;--d:.4s">
          <svg class="clip" aria-hidden="true"><use href="#clip"/></svg>
          <img src="/img/kamila-lake.jpg" alt="Камила у озера в Китае" width="460" height="575">
          <figcaption class="hand">это я — 9-й год в Китае</figcaption>
        </figure>
        <div class="ticket drop" style="--r:-4deg;--d:.65s">
          <div class="ticket__main">
            <small class="mono">登机牌 · посадочный талон</small>
            <b>MOW <span>→</span> PEK</b>
            <small class="mono">пассажир: вы · рейс 2027</small>
          </div>
          <div class="ticket__stub mono"><small>место</small><b>CSC</b></div>
        </div>
        <span class="seal drop" style="--r:14deg;--d:.95s" aria-hidden="true">录取</span>
        <svg class="stk collage__cat drop" style="--r:-8deg;--d:1.1s" aria-hidden="true"><use href="#s-cat"/></svg>
        <svg class="stk collage__orange drop" style="--r:12deg;--d:1.25s" aria-hidden="true"><use href="#s-orange"/></svg>
        <svg class="stk collage__grant drop" style="--r:0deg;--d:1.4s" aria-hidden="true"><use href="#s-grant"/></svg>
        <svg class="stk collage__lantern swing" aria-hidden="true"><use href="#s-lantern"/></svg>
        <span class="tape tape--blue collage__tape" aria-hidden="true"></span>
      </div>
    </div>

    <div class="container">
      <ul class="notes">
        <li class="note note--blue reveal" style="--r:-2deg"><span class="tape tape--lime"></span><strong><%= s.stat1_value %></strong><span><%= s.stat1_label %></span></li>
        <li class="note note--paper reveal" style="--r:1.5deg;--d:.1s"><span class="tape tape--blue"></span><strong><%= s.stat2_value %></strong><span><%= s.stat2_label %></span></li>
        <li class="note note--lime reveal" style="--r:-1deg;--d:.2s"><span class="tape tape--paper"></span><strong><%= s.stat3_value %></strong><span><%= s.stat3_label %></span></li>
      </ul>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <% for (let k = 0; k < 2; k++) { %>
      <span>留学中国 ✶ гранты CSC ✶ HSK ✶ стратегия 2+3 ✶ языковой год ✶ бакалавриат ✶ магистратура ✶ 加油 ✶ мотивационное письмо ✶ интервью ✶ зачисление ✶&nbsp;</span>
      <% } %>
    </div>
  </div>

  <!-- ═══ ОБО МНЕ ═══ -->
  <section class="section about" id="about">
    <div class="container">
      <div class="sec-head reveal">
        <span class="cn sec-head__cn" aria-hidden="true">关于我</span>
        <h2 class="h2">Обо мне</h2>
      </div>
      <div class="about__grid">
        <figure class="polaroid polaroid--blank about__photo reveal" data-from="left" style="--r:-3deg">
          <svg class="clip" aria-hidden="true"><use href="#clip"/></svg>
          <img src="/img/kamila.jpg" alt="Камила — ментор по поступлению в Китай" width="1000" height="1250" loading="lazy">
          <span class="seal about__seal" aria-hidden="true">导师</span>
          <svg class="stk about__flower" aria-hidden="true"><use href="#s-flower"/></svg>
        </figure>
        <div class="about__text reveal" data-from="right">
          <h3 class="h3">Привет, я Камила!</h3>
          <p class="hand hand--lg">ментор по поступлению в Китай</p>
          <p class="about__story">С 2017 года живу и учусь в Китае. Прошла путь от языковых курсов до <mark class="hl hl--lime">магистратуры на полном гранте</mark> и сдала <mark class="hl hl--blue">HSK 5 и HSKK на 70 баллов</mark>. Помогаю поступать в университеты Китая честно, осознанно и без лишних затрат.</p>
          <div class="checklist">
            <p class="checklist__title hand">почему со мной?</p>
            <ul>
              <% ['Честная и прозрачная работа','Индивидуальная стратегия','Опыт учёбы в Китае изнутри','Поддержка на всех этапах','Фокус на результат, а не на количество'].forEach((t, i) => { %>
              <li style="--d:<%= i * 120 %>ms"><svg class="htick" aria-hidden="true"><use href="#htick"/></svg><%= t %></li>
              <% }) %>
            </ul>
            <svg class="stk checklist__bao" aria-hidden="true"><use href="#s-cookie"/></svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ УСЛУГИ ═══ -->
  <section class="section services" id="services">
    <div class="container">
      <div class="sec-head reveal">
        <span class="cn sec-head__cn" aria-hidden="true">服务</span>
        <h2 class="h2">Услуги</h2>
      </div>
      <div class="services__grid">
        <% const arts = [
              [['s-hongbao', 18, 14, 70, 108, -10], ['s-cloud', 4, 92, 96, 52, 0], ['s-cat', 98, 4, 112, 132, 6]],
              [['s-lantern', 14, 0, 52, 92, -6], ['s-jiayou', 62, 18, 136, 72, -4], ['s-candy', 20, 92, 110, 56, 8], ['s-orange', 140, 80, 66, 66, 10]],
              [['s-knot', 8, 0, 54, 86, 0], ['s-cookie', 52, 28, 140, 108, -6], ['s-flower', 160, 4, 48, 48, 14]]
            ]; services.forEach((x, i) => { const tone = tones[i % 3]; const full = x.title + (x.subtitle ? ' (' + x.subtitle + ')' : ''); const feats = x.features.split('\n').map(f => f.trim()).filter(Boolean); %>
        <article class="pkg pkg--<%= tone %> reveal" data-from="up" style="--d:<%= i * 110 %>ms">
          <span class="pkg__no mono">№0<%= i + 1 %></span>
          <div class="pkg__art">
            <% if (x.photo) { %><img src="<%= x.photo %>" alt="" loading="lazy"><% } else { %><svg viewBox="0 0 220 150" aria-hidden="true"><% arts[i % 3].forEach(([id, x, y, w, h, r]) => { %><use href="#<%= id %>" x="<%= x %>" y="<%= y %>" width="<%= w %>" height="<%= h %>" transform="rotate(<%= r %> <%= x + w / 2 %> <%= y + h / 2 %>)"/><% }) %></svg><% } %>
          </div>
          <h3 class="pkg__title"><%= x.title %></h3>
          <% if (x.subtitle) { %><p class="hand pkg__sub"><%= x.subtitle %></p><% } %>
          <p class="pkg__desc"><%= x.description %></p>
          <% if (feats.length) { %>
          <ul class="pkg__list"><% feats.forEach(f => { %><li><svg class="htick" aria-hidden="true"><use href="#htick"/></svg><%= f %></li><% }) %></ul>
          <% } %>
          <div class="pkg__foot">
            <span class="price mono"><%= x.price %></span>
            <a href="#contacts" class="btn btn--ink btn--sm" data-pick="<%= full %>" data-goal="service_pick">Выбрать <%- icon('arrow') %></a>
          </div>
        </article>
        <% }) %>
      </div>
      <aside class="nudge reveal" data-from="up">
        <span class="tape tape--blue"></span>
        <p class="hand nudge__title">Не знаете, с чего начать?</p>
        <p class="hand nudge__text">запишитесь на консультацию — разберём ваш кейс и составим пошаговый план</p>
        <svg class="harrow nudge__arrow" aria-hidden="true"><use href="#harrow"/></svg>
        <a href="#contacts" class="btn btn--lime" data-goal="cta_services">Записаться <%- icon('arrow-up-right') %></a>
      </aside>
    </div>
  </section>

  <!-- ═══ ЭТАПЫ: заметки на развороте ═══ -->
  <section class="section steps" id="steps">
    <div class="container">
      <div class="sec-head reveal">
        <span class="cn sec-head__cn" aria-hidden="true">步骤</span>
        <h2 class="h2">Этапы работы</h2>
      </div>
      <ol class="steps__list">
        <% [['分析','Анализ кейса и целей','Разбираем образование, уровень языка, бюджет и цели. Честно оцениваем шансы.'],
            ['选校','Подбор университетов','Стратегия 2+3: два вуза мечты и три надёжных варианта под ваш профиль.'],
            ['文件','Подготовка документов','Мотивационное письмо, CV и рекомендации — под требования каждого вуза.'],
            ['申请','Подача заявок','Подаём заявки, следим за статусами и готовим к интервью.'],
            ['录取','Зачисление','Получаем приглашение — и остаёмся на связи после зачисления.']].forEach(([cn, t, d], i) => { %>
        <li class="step step--<%= ['blue','paper','lime','paper','blue'][i] %> reveal" data-from="up" style="--d:<%= i * 120 %>ms; --r:<%= [-2, 1.5, -1, 2, -1.5][i] %>deg">
          <span class="tape tape--<%= ['lime','blue','paper','lime','blue'][i] %>"></span>
          <span class="step__num">0<%= i + 1 %></span>
          <span class="cn step__cn" aria-hidden="true"><%= cn %></span>
          <h3 class="step__title"><%= t %></h3>
          <p class="step__text"><%= d %></p>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- ═══ РЕЗУЛЬТАТЫ: папка-досье с закладками ═══ -->
  <section class="section results" id="results">
    <div class="container">
      <div class="sec-head reveal">
        <span class="cn sec-head__cn" aria-hidden="true">成果</span>
        <h2 class="h2">Результаты студентов</h2>
      </div>
      <div class="results__grid">
        <div class="dossier reveal" data-from="left" data-tabs>
          <div class="dossier__tabs" role="tablist" aria-label="Студенты">
            <% results.forEach((r, i) => { %>
            <button class="ftab ftab--<%= tones[i % 3] %>" role="tab" type="button" id="rtab-<%= i %>" aria-controls="rpanel-<%= i %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>"><%= r.name %></button>
            <% }) %>
          </div>
          <div class="dossier__body">
            <% results.forEach((r, i) => { %>
            <article class="case" role="tabpanel" id="rpanel-<%= i %>" aria-labelledby="rtab-<%= i %>" <%= i === 0 ? '' : 'hidden' %>>
              <figure class="polaroid case__photo">
                <svg class="clip" aria-hidden="true"><use href="#clip"/></svg>
                <% if (r.photo) { %><img src="<%= r.photo %>" alt="<%= r.name %>" loading="lazy"><% } else { %><span class="polaroid__empty cn">录取</span><% } %>
                <figcaption class="hand"><%= r.name %></figcaption>
              </figure>
              <div class="case__text">
                <p class="mono case__no">досье № <%= String(i + 1).padStart(3, '0') %></p>
                <h3 class="h3"><%= r.name %></h3>
                <p class="case__program"><%= r.program %><% if (r.university) { %><br><%= r.university %><% } %></p>
                <p><%= r.text %></p>
              </div>
              <% if (r.badge) { %><span class="seal seal--stamp" aria-label="<%= r.badge %>">录取<small><%= r.badge %></small></span><% } %>
            </article>
            <% }) %>
          </div>
        </div>
        <div class="report reveal" data-from="right" style="--r:1.5deg">
          <span class="tape tape--paper"></span>
          <p class="mono report__head">отчёт · 报告 · 2026</p>
          <dl>
            <div><dt><%= s.res1_value %></dt><dd><%= s.res1_label %></dd></div>
            <div><dt><%= s.res2_value %></dt><dd><%= s.res2_label %></dd></div>
            <div><dt><%= s.res3_value %></dt><dd><%= s.res3_label %></dd></div>
          </dl>
          <svg class="stk report__star" aria-hidden="true"><use href="#s-orange"/></svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ОТЗЫВЫ: книжка с закладками ═══ -->
  <section class="section reviews" id="reviews">
    <div class="container">
      <div class="sec-head reveal">
        <span class="cn sec-head__cn" aria-hidden="true">日记</span>
        <h2 class="h2">Отзывы</h2>
      </div>
      <div class="book reveal" data-from="up" data-book>
        <div class="book__page book__page--left">
          <span class="cn book__cn" aria-hidden="true">日记</span>
          <p class="mono">дневник отзывов</p>
          <p class="hand book__hint">истории студентов, которые уже учатся в Китае. тяните за закладки →</p>
          <svg class="stk book__panda" aria-hidden="true"><use href="#s-noodles"/></svg>
        </div>
        <div class="book__spine" aria-hidden="true"></div>
        <div class="book__page book__page--right">
          <div class="book__content">
            <% reviews.forEach((r, i) => { %>
            <article class="entry" role="tabpanel" id="entry-<%= i %>" aria-labelledby="bm-<%= i %>" <%= i === 0 ? '' : 'hidden' %>>
              <p class="mono entry__no">запись № <%= String(i + 1).padStart(2, '0') %></p>
              <header class="entry__head">
                <% if (r.photo) { %><img src="<%= r.photo %>" alt="" class="entry__ava" loading="lazy"><% } else { %><span class="entry__ava entry__ava--letter"><%= r.name.charAt(0) %></span><% } %>
                <div>
                  <h3 class="entry__name"><%= r.name %><% if (r.location) { %>, <%= r.location %><% } %></h3>
                  <% if (r.program) { %><p class="mono entry__prog"><%= r.program %></p><% } %>
                </div>
              </header>
              <blockquote class="hand entry__text"><%= r.text %></blockquote>
            </article>
            <% }) %>
          </div>

          <div class="book__pager mono">
            <button type="button" data-dir="-1" aria-label="Предыдущий отзыв">←</button>
            <span><b data-cur>1</b> / <%= reviews.length %></span>
            <button type="button" data-dir="1" aria-label="Следующий отзыв">→</button>
          </div>
        </div>
          <div class="book__tabs" role="tablist" aria-label="Отзывы">
          <% reviews.forEach((r, i) => { %>
          <button class="bookmark bookmark--<%= ['lime','blue','red','green'][i % 4] %>" role="tab" type="button" id="bm-<%= i %>" aria-controls="entry-<%= i %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>"><%= r.name %></button>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="section faq" id="faq">
    <div class="container faq__grid">
      <div>
        <div class="sec-head reveal">
          <span class="cn sec-head__cn" aria-hidden="true">问答</span>
          <h2 class="h2">Частые вопросы</h2>
        </div>
        <div class="faq__list">
          <% faq.forEach((q, i) => { %>
          <details class="qa reveal" data-from="left" style="--d:<%= i * 60 %>ms">
            <summary><span class="mono qa__n">Q<%= i + 1 %>.</span><span class="qa__q"><%= q.question %></span><%- icon('plus') %></summary>
            <div class="qa__a"><p><%= q.answer %></p></div>
          </details>
          <% }) %>
        </div>
      </div>
      <div class="faq__side">
        <figure class="polaroid faq__panda reveal" data-from="right" style="--r:-4deg">
          <span class="tape tape--blue"></span>
          <img src="/img/panda.jpg" alt="Панда отдыхает на камне среди бамбука" loading="lazy">
          <figcaption class="hand">сосед по кампусу (почти)</figcaption>
        </figure>
        <svg class="stk faq__knot" aria-hidden="true"><use href="#s-knot"/></svg>
        <div class="fortune reveal" data-from="up" style="--r:3deg">
          <span class="cn">你能行</span>
          <span class="mono">«у тебя получится» — записка из печенья с предсказанием</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ЗАЯВКА: письмо ═══ -->
  <section class="contact" id="contacts">
    <svg class="cloud cloud--1" aria-hidden="true"><use href="#cloud"/></svg>
    <svg class="cloud cloud--2" aria-hidden="true"><use href="#cloud"/></svg>
    <div class="container">
      <div class="letter reveal" data-from="up">
        <figure class="stamp letter__stamp" aria-hidden="true">
          <img src="/img/cta.jpg" alt="" loading="lazy">
          <figcaption class="mono">中国 <b>¥8</b></figcaption>
        </figure>
        <svg class="stk letter__hb" aria-hidden="true"><use href="#s-hongbao"/></svg>
        <span class="postmark mono" aria-hidden="true">GSP·INCH ✶ 2027 ✶ 留学 ✶</span>
        <div class="letter__head">
          <p class="mono letter__to">кому: Камиле · куда: Китай · тема: поступление</p>
          <h2 class="h2">Запишитесь на консультацию</h2>
          <p class="hand hand--lg">разберём ваш кейс, оценим шансы и составим пошаговый план</p>
          <% if (tg) { %>
            <a href="<%= tg %>" class="letter__tg mono" target="_blank" rel="noopener" data-goal="telegram_click"><%- icon('telegram') %> или напишите в Telegram</a>
          <% } %>
        </div>
        <form class="form" id="lead-form" action="/api/lead" method="post" novalidate>
          <% if (sent) { %><p class="form__ok" role="status">Спасибо! Заявка отправлена — я свяжусь с вами в ближайшее время.</p><% } %>
          <label for="f-name"><span>Ваше имя</span><input id="f-name" name="name" required maxlength="100" autocomplete="name" placeholder="Как к вам обращаться"></label>
          <label for="f-contact"><span>Как с вами связаться</span><input id="f-contact" name="contact" required maxlength="150" placeholder="Telegram, WhatsApp или телефон"></label>
          <label for="f-package"><span>Что вас интересует</span>
            <select id="f-package" name="package">
              <option value="">Пока не знаю — нужна консультация</option>
              <% services.forEach((x) => { %><option><%= x.title %><%= x.subtitle ? ' (' + x.subtitle + ')' : '' %></option><% }) %>
            </select>
          </label>
          <label for="f-msg"><span>Пара слов о себе <i>— необязательно</i></span><textarea id="f-msg" name="message" rows="3" maxlength="2000" placeholder="Уровень образования, желаемая программа…"></textarea></label>
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="utm">
          <label class="check" for="f-agree"><input id="f-agree" type="checkbox" required checked> <span>Согласна(ен) на обработку персональных данных согласно <a href="/privacy" target="_blank">политике</a></span></label>
          <button class="btn btn--lime" type="submit">Отправить письмо <%- icon('send') %></button>
          <p class="form__msg" role="status" aria-live="polite"></p>
        </form>
        <span class="seal seal--sent" aria-hidden="true">已发送<small>отправлено</small></span>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=2" defer></script>
</body>
</html>
