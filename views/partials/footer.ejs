<footer class="footer">
  <div class="container footer__inner">
    <a href="/" class="logo">
      <span class="logo__mark">GSP<i>·</i>INCH</span>
      <span class="logo__sub">Поступление в Китай</span>
    </a>
    <nav class="footer__nav" aria-label="Меню в подвале">
      <a href="/#about">Обо мне</a><a href="/#services">Услуги</a><a href="/#steps">Этапы</a>
      <a href="/#results">Результаты</a><a href="/#faq">FAQ</a><a href="/#contacts">Контакты</a>
    </nav>
    <div class="socials">
      <% [['telegram','Telegram'],['instagram','Instagram'],['tiktok','TikTok'],['youtube','YouTube'],['whatsapp','WhatsApp']].forEach(([k, label]) => {
           if (s[k] && s[k] !== 'https://t.me/') { %>
        <a href="<%= s[k] %>" target="_blank" rel="noopener" aria-label="<%= label %>" data-goal="social_<%= k %>"><%- icon(k) %></a>
      <% } }) %>
      <% if (s.email) { %><a href="mailto:<%= s.email %>" aria-label="E-mail"><%- icon('mail') %></a><% } %>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© <%= new Date().getFullYear() %> GSP·INCH</span>
    <a href="/privacy">Политика конфиденциальности</a>
  </div>
</footer>
