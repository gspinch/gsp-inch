<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;800;900&family=PT+Mono&family=Caveat:wght@500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@300;500&display=swap&text=<%= encodeURIComponent(cnText) %>" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=2">
<meta name="theme-color" content="#eee8da">
<% if (s.yandex_verification) { %><meta name="yandex-verification" content="<%= s.yandex_verification %>"><% } %>
<% if (s.google_verification) { %><meta name="google-site-verification" content="<%= s.google_verification %>"><% } %>
<% if (/^\d+$/.test(s.metrika_id || '')) { %>
<!-- Yandex.Metrika -->
<script>
(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
ym(<%= s.metrika_id %>,"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
window.METRIKA_ID=<%= s.metrika_id %>;
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/<%= s.metrika_id %>" style="position:absolute;left:-9999px" alt=""></div></noscript>
<% } %>
<% if (/^G-[A-Z0-9]+$/.test(s.ga_id || '')) { %>
<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= s.ga_id %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= s.ga_id %>');</script>
<% } %>
