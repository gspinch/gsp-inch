      <path d="M188 92c10-2 14-10 8-16" fill="none" stroke="#e0a21a" stroke-width="4" stroke-linecap="round"/>
    </g>
  </symbol>

  <!-- китайский узел -->
  <symbol id="s-knot" viewBox="-14 -14 148 204">
    <g filter="url(#dc)" fill="none" stroke="#d8402f" stroke-width="6" stroke-linecap="round">
      <path d="M60 0v12"/>
      <g transform="rotate(45 60 64)">
        <rect x="30" y="34" width="60" height="60"/>
        <path d="M45 34v60M60 34v60M75 34v60M30 49h60M30 64h60M30 79h60" stroke-width="4"/>
      </g>
      <circle cx="60" cy="14" r="9"/><circle cx="108" cy="64" r="9"/><circle cx="12" cy="64" r="9"/><circle cx="60" cy="114" r="9"/>
      <path d="M60 123v12"/>
      <rect x="53" y="135" width="14" height="8" fill="#f7c434" stroke="#f7c434" stroke-width="2"/>
      <path d="M56 145v30M60 145v34M64 145v30" stroke-width="3"/>
    </g>
  </symbol>

  <!-- красный конверт хунбао -->
  <symbol id="s-hongbao" viewBox="-12 -12 134 174">
    <g filter="url(#dc)">
      <rect x="10" y="10" width="90" height="130" rx="8" fill="#d8402f"/>
      <path d="M10 22q45 46 90 0V18q-45 40-90 0Z" fill="#b02a1c"/>
      <circle cx="55" cy="64" r="18" fill="#f7c434" stroke="#e0a21a" stroke-width="3"/>
      <text x="55" y="73" text-anchor="middle" font-size="22" fill="#d8402f" font-family="'Ma Shan Zheng','KaiTi',serif">福</text>
      <path d="M22 112h66M22 122h66" stroke="#f7c434" stroke-width="3" stroke-dasharray="6 5"/>
    </g>
  </symbol>

  <!-- лапша с палочками -->
  <symbol id="s-noodles" viewBox="-12 -12 204 164">
    <g filter="url(#dc)">
      <path d="M104 6 176 36M96 14l76 30" stroke="#9b1c22" stroke-width="8" stroke-linecap="round"/>
      <path d="M58 76c0-20 6-36 14-48 4 16-2 34-2 48M76 76c2-22 10-36 22-50 2 18-8 34-10 50M94 76c4-18 10-30 24-42" fill="none" stroke="#9b1c22" stroke-width="5" stroke-linecap="round"/>
