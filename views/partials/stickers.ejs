  <symbol id="htick" viewBox="0 0 30 30"><path d="M4 16c4 3 6 6 8 10 4-10 8-16 15-22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
