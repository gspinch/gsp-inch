  <!-- конфета -->
  <symbol id="s-candy" viewBox="-12 -12 224 114">
    <g filter="url(#dc)">
      <path d="M52 32 12 10l10 35-10 35 40-22Z" fill="#fff" stroke="#2f4fa0" stroke-width="3" stroke-linejoin="round"/>
      <path d="M148 32l40-22-10 35 10 35-40-22Z" fill="#fff" stroke="#2f4fa0" stroke-width="3" stroke-linejoin="round"/>
      <circle cx="26" cy="30" r="4" fill="#2f4fa0"/><circle cx="32" cy="46" r="4" fill="#2f4fa0"/><circle cx="26" cy="62" r="4" fill="#2f4fa0"/>
      <circle cx="174" cy="30" r="4" fill="#2f4fa0"/><circle cx="168" cy="46" r="4" fill="#2f4fa0"/><circle cx="174" cy="62" r="4" fill="#2f4fa0"/>
      <rect x="46" y="20" width="108" height="52" rx="24" fill="#fff" stroke="#2f4fa0" stroke-width="3"/>
      <path d="M62 22v48M68 22v48M132 22v48M138 22v48" stroke="#d8402f" stroke-width="2.5"/>
      <circle cx="100" cy="46" r="18" fill="#2b2620"/>
      <text x="100" y="54" text-anchor="middle" font-size="20" fill="#fff" font-family="'Ma Shan Zheng','KaiTi',serif">甜</text>
      <circle cx="116" cy="34" r="7" fill="#ef6a54"/>
    </g>
  </symbol>

  <!-- цветок сливы -->
  <symbol id="s-flower" viewBox="-12 -12 134 134">
    <g filter="url(#dc)">
      <g fill="#f6a8bd" stroke="#e57f9b" stroke-width="2.5">
        <circle cx="55" cy="26" r="22"/><circle cx="84" cy="47" r="22"/><circle cx="73" cy="82" r="22"/><circle cx="37" cy="82" r="22"/><circle cx="26" cy="47" r="22"/>
      </g>
      <circle cx="55" cy="56" r="13" fill="#f7c434"/>
      <path d="M55 56l0-20M55 56l18-8M55 56l12 16M55 56l-12 16M55 56l-18-8" stroke="#d8402f" stroke-width="2" stroke-linecap="round"/>
    </g>
  </symbol>

  <!-- надписи-стикеры -->
  <symbol id="s-jiayou" viewBox="-14 -14 248 128">
    <g filter="url(#dc)">
      <text x="110" y="82" text-anchor="middle" font-size="86" fill="#d8402f" stroke="#f6b4c8" stroke-width="10" paint-order="stroke" stroke-linejoin="round" font-family="'Ma Shan Zheng','KaiTi',serif">加油!</text>
    </g>
  </symbol>
  <symbol id="s-grant" viewBox="-14 -14 268 138">
    <g filter="url(#dc)" transform="rotate(-6 120 55)">
      <text x="120" y="50" text-anchor="middle" font-size="46" font-weight="900" letter-spacing="-2" fill="#d8402f" stroke="#f6b4c8" stroke-width="10" paint-order="stroke" stroke-linejoin="round" font-family="Onest, Arial, sans-serif"><%= t('st_grant1') %></text>
