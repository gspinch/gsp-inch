<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <!-- «вырубной» стикер: белая обводка по контуру + мягкая тень -->
    <filter id="dc" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
      <feMorphology in="SourceAlpha" operator="dilate" radius="6" result="d"/>
      <feGaussianBlur in="d" stdDeviation="3" result="b"/>
      <feOffset in="b" dx="2" dy="5" result="o"/>
      <feFlood flood-color="#2b2620" flood-opacity=".3"/>
      <feComposite in2="o" operator="in" result="sh"/>
      <feFlood flood-color="#ffffff"/>
      <feComposite in2="d" operator="in" result="w"/>
      <feMerge><feMergeNode in="sh"/><feMergeNode in="w"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- манэки-нэко — кошка удачи с монетой 福 -->
  <symbol id="s-cat" viewBox="-12 -12 184 204">
    <g filter="url(#dc)">
      <rect x="30" y="92" width="104" height="84" rx="36" fill="#fff" stroke="#cdd6ee" stroke-width="3"/>
      <ellipse cx="54" cy="172" rx="16" ry="8" fill="#fff" stroke="#cdd6ee" stroke-width="3"/>
      <ellipse cx="110" cy="172" rx="16" ry="8" fill="#fff" stroke="#cdd6ee" stroke-width="3"/>
      <path d="M34 54 38 10 70 36Z" fill="#fff" stroke="#cdd6ee" stroke-width="3" stroke-linejoin="round"/>
      <path d="M42 42 44 22 60 36Z" fill="#f6b4c3"/>
      <path d="M130 54 126 10 94 36Z" fill="#f39a1e" stroke="#cdd6ee" stroke-width="3" stroke-linejoin="round"/>
      <ellipse cx="82" cy="72" rx="56" ry="46" fill="#fff" stroke="#cdd6ee" stroke-width="3"/>
      <path d="M100 30c10-4 22 0 28 10-8 6-22 6-28-10Z" fill="#f39a1e"/>
      <ellipse cx="62" cy="74" rx="6.5" ry="8.5" fill="#2f4fa0"/>
      <ellipse cx="102" cy="74" rx="6.5" ry="8.5" fill="#2f4fa0"/>
      <circle cx="64" cy="71" r="2" fill="#fff"/><circle cx="104" cy="71" r="2" fill="#fff"/>
      <path d="M78 84h8l-4 5Z" fill="#f08aa3"/>
      <path d="M74 92q4 5 8 0q4 5 8 0" fill="none" stroke="#2b2620" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="46" cy="90" r="7" fill="#f6b4c3" opacity=".8"/><circle cx="118" cy="90" r="7" fill="#f6b4c3" opacity=".8"/>
      <path d="M16 76h16M14 86h17M140 76h-14M142 86h-16" stroke="#cdd6ee" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M38 108q44 26 88 0v12q-44 28-88 0Z" fill="#d8402f"/>
      <path d="M48 112q34 18 68 0" fill="none" stroke="#4f7a34" stroke-width="6" stroke-linecap="round"/>
      <circle cx="82" cy="128" r="10" fill="#f7c434" stroke="#e0a21a" stroke-width="2.5"/>
      <path d="M77 128h10" stroke="#e0a21a" stroke-width="2"/>
      <ellipse cx="22" cy="64" rx="15" ry="20" fill="#fff" stroke="#cdd6ee" stroke-width="3"/>
      <path d="M14 52v6M22 50v7M30 52v6" stroke="#cdd6ee" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="118" cy="150" r="22" fill="#f7c434" stroke="#e0a21a" stroke-width="3"/>
      <text x="118" y="159" text-anchor="middle" font-size="24" fill="#d8402f" font-family="'Ma Shan Zheng','KaiTi',serif">福</text>
      <ellipse cx="138" cy="160" rx="12" ry="10" fill="#fff" stroke="#cdd6ee" stroke-width="3"/>
    </g>
  </symbol>

  <!-- мандарин с наклейкой 福 -->
  <symbol id="s-orange" viewBox="-12 -12 174 174">
    <g filter="url(#dc)">
