      <rect x="10" y="68" width="160" height="12" rx="6" fill="#9b1c22"/>
      <path d="M30 98c10-8 20 8 30 0s20 8 30 0 20 8 30 0 20 8 30 0" fill="none" stroke="#f6b4c8" stroke-width="4" stroke-linecap="round"/>
