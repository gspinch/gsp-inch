      <ellipse cx="50" cy="64" rx="15" ry="9" transform="rotate(-35 50 64)" fill="#ffc463"/>
      <circle cx="40" cy="90" r="2" fill="#e07f12"/><circle cx="96" cy="120" r="2" fill="#e07f12"/><circle cx="58" cy="122" r="2" fill="#e07f12"/>
      <rect x="70" y="18" width="8" height="18" rx="2" transform="rotate(10 74 27)" fill="#7a3b1a"/>
      <path d="M78 32c18-24 52-24 66-10-16 18-44 22-66 10Z" fill="#4f7a34"/>
      <path d="M82 31c20-4 38-8 56-10" stroke="#f6b4c3" stroke-width="2"/>
      <rect x="66" y="80" width="34" height="34" transform="rotate(45 83 97)" fill="#d8402f"/>
      <text x="83" y="106" text-anchor="middle" font-size="24" fill="#f7c434" font-family="'Ma Shan Zheng','KaiTi',serif">福</text>
      <path d="M118 52l3 8 8 3-8 3-3 8-3-8-8-3 8-3Z" fill="#fff"/>
    </g>
  </symbol>

  <!-- печенье с предсказанием -->
  <symbol id="s-cookie" viewBox="-12 -12 196 150">
