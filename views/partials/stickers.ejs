  <!-- служебные -->
  <symbol id="clip" viewBox="0 0 30 90">
    <path d="M9 70V16a8 8 0 0 1 16 0v58a12 12 0 0 1-24 0V24" fill="none" stroke="#9aa0a8" stroke-width="3.2" stroke-linecap="round"/>
