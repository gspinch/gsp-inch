  <symbol id="cloud" viewBox="0 0 200 90"><path d="M30 80c-20 0-28-24-10-34-4-22 22-34 38-20 6-24 44-30 58-6 16-12 44-4 44 18 22 0 32 28 10 42Z" fill="#fff"/></symbol>

