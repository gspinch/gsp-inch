      <path d="M50 0v18" stroke="#2b2620" stroke-width="3"/>
      <rect x="32" y="16" width="36" height="12" rx="3" fill="#f7c434"/>
      <ellipse cx="50" cy="72" rx="44" ry="46" fill="#d8402f"/>
      <path d="M50 26c-22 12-22 80 0 92M50 26c22 12 22 80 0 92M26 32c-18 18-18 62 0 80M74 32c18 18 18 62 0 80" fill="none" stroke="#b02a1c" stroke-width="3"/>
      <ellipse cx="30" cy="60" rx="6" ry="16" fill="#ef6a54"/>
      <rect x="32" y="116" width="36" height="12" rx="3" fill="#f7c434"/>
      <rect x="44" y="128" width="12" height="8" fill="#f7c434"/>
